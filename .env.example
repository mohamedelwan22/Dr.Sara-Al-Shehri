# Supabase (المطلوبة لتشغيل التطبيق — انسخ إلى .env واملأ القيم من مشروع Supabase)
# لا تضع service_role هنا أبدًا — anon/publishable فقط
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# رابط Edge Function للتنزيل الآمن (اختياري حتى تنشر الدالة)
# VITE_SUPABASE_FUNCTIONS_URL=https://YOUR-PROJECT.supabase.co/functions/v1

# رابط Edge Function لتسجيل التفاعلات (اختياري)
# VITE_RECORD_INTERACTION_FUNCTION=record-interaction
